{
  "name": "sparklingstadt-id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "oidc:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/oidc-keygen.ts",
    "oidc:client": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/oidc-client.ts",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:regression": "pnpm run lint && pnpm run test:unit && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.28",
    "@better-auth/passkey": "1.7.28",
    "@next/env": "16.4.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.28",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.54.0",
    "next": "16.4.6",
    "next-intl": "^4.14.1",
    "pg": "^8.23.0",
    "radix-ui": "1.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
