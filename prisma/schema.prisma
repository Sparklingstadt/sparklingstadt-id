generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The first implementation's tables: drop after the cutover is confirmed (follow-up PR; SQL in
// docs/cutover/drop-legacy-tables.sql). Only scripts/import-legacy.ts reads `users`, with SQL.
enum EmailTokenPurpose {
  verify
  change_email
  reset_password

  @@map("email_token_purpose")
}

model LegacyUser {
  id              String    @id @default(cuid())
  email           String    @unique
  displayName     String    @map("display_name")
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  sessionVersion  Int       @default(0) @map("session_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions    LegacySession[]
  emailTokens EmailToken[]
  authCodes   AuthCode[]

  @@map("users")
}

model LegacySession {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  tokenHash      String   @unique @map("token_hash")
  sessionVersion Int      @map("session_version")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String            @map("user_id")
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  email     String
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model AuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique @map("code_hash")
  clientId      String    @map("client_id")
  userId        String    @map("user_id")
  redirectUri   String    @map("redirect_uri")
  codeChallenge String    @map("code_challenge")
  nonce         String?
  authTime      DateTime  @map("auth_time")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user LegacyUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_codes")
}

model Throttle {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("throttles")
}

// Better Auth's core tables. Model names are the ones Better Auth looks up (user, session, ...);
// table names keep the ba_ prefix so they stay apart from the legacy tables until those are dropped.
model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  // twoFactor plugin: on once the first TOTP is confirmed (lib/auth.ts).
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  sessions           Session[]
  accounts           Account[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  passkeys           Passkey[]
  twoFactors         TwoFactor[]

  @@map("ba_users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
  @@map("ba_sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ba_accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("ba_verifications")
}

// Better Auth's rate limiter (rateLimit.storage: "database"); lastRequest is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("ba_rate_limits")
}

// The jwt plugin's signing keys (the ID token's ES256 key; the private key is encrypted with BETTER_AUTH_SECRET).
model Jwks {
  id         String    @id
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")
  alg        String?
  crv        String?

  @@map("ba_jwks")
}

// The oauth-provider plugin's tables. Model names are the ones the plugin looks up; json fields are text
// (the Prisma adapter stores them as JSON strings).
model OauthClient {
  id                               String    @id
  clientId                         String    @unique @map("client_id")
  clientSecret                     String?   @map("client_secret")
  clientDiscoveryId                String?   @map("client_discovery_id")
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?  @map("skip_consent")
  enableEndSession                 Boolean?  @map("enable_end_session")
  subjectType                      String?   @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([]) @map("client_credentials_scopes")
  userId                           String?   @map("user_id")
  createdAt                        DateTime? @map("created_at")
  updatedAt                        DateTime? @map("updated_at")
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?   @map("software_id")
  softwareVersion                  String?   @map("software_version")
  softwareStatement                String?   @map("software_statement")
  redirectUris                     String[]  @map("redirect_uris")
  postLogoutRedirectUris           String[]  @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?   @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?  @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?   @map("token_endpoint_auth_method")
  applicationType                  String?   @map("application_type")
  jwks                             String?
  jwksUri                          String?   @map("jwks_uri")
  grantTypes                       String[]  @map("grant_types")
  responseTypes                    String[]  @map("response_types")
  requirePKCE                      Boolean?  @map("require_pkce")
  dpopBoundAccessTokens            Boolean?  @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?   @map("reference_id")
  metadata                         String?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("ba_oauth_clients")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?      @map("access_token_ttl")
  refreshTokenTtl               Int?      @map("refresh_token_ttl")
  signingAlgorithm              String?   @map("signing_algorithm")
  signingKeyId                  String?   @map("signing_key_id")
  allowedScopes                 String[]  @map("allowed_scopes")
  customClaims                  String?   @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?  @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @map("created_at")
  updatedAt                     DateTime? @map("updated_at")
  policyVersion                 Int?      @default(1) @map("policy_version")
  metadata                      String?

  clients OauthClientResource[]

  @@map("ba_oauth_resources")
}

model OauthClientResource {
  id         String    @id
  clientId   String    @map("client_id")
  resourceId String    @map("resource_id")
  metadata   String?
  createdAt  DateTime? @map("created_at")

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("ba_oauth_client_resources")
}

model OauthRefreshToken {
  id                      String    @id
  token                   String    @unique
  clientId                String    @map("client_id")
  sessionId               String?   @map("session_id")
  userId                  String    @map("user_id")
  referenceId             String?   @map("reference_id")
  authorizationCodeId     String?   @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  expiresAt               DateTime? @map("expires_at")
  createdAt               DateTime? @map("created_at")
  revoked                 DateTime?
  rotatedAt               DateTime? @map("rotated_at")
  rotationReplayResponse  String?   @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime? @map("rotation_replay_expires_at")
  authTime                DateTime? @map("auth_time")
  confirmation            String?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("ba_oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String    @id
  token                   String?   @unique
  clientId                String    @map("client_id")
  sessionId               String?   @map("session_id")
  userId                  String?   @map("user_id")
  referenceId             String?   @map("reference_id")
  authorizationCodeId     String?   @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  refreshId               String?   @map("refresh_id")
  expiresAt               DateTime? @map("expires_at")
  createdAt               DateTime? @map("created_at")
  revoked                 DateTime?
  confirmation            String?
  scopes                  String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("ba_oauth_access_tokens")
}

model OauthConsent {
  id                      String    @id
  clientId                String    @map("client_id")
  userId                  String?   @map("user_id")
  referenceId             String?   @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[]  @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime? @map("created_at")
  updatedAt               DateTime? @map("updated_at")

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("ba_oauth_consents")
}

// Single-use private_key_jwt assertion ids (unused here: every client uses a secret).
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@map("ba_oauth_client_assertions")
}

// The passkey plugin's table: a passkey belongs to a signed-in user and is named, listed and deleted on /account.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String    @map("public_key")
  userId       String    @map("user_id")
  credentialID String    @unique @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type")
  backedUp     Boolean   @map("backed_up")
  transports   String?
  createdAt    DateTime? @map("created_at")
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ba_passkeys")
}

/// The twoFactor plugin's TOTP secret and backup codes, both encrypted with BETTER_AUTH_SECRET.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("ba_two_factors")
}
