DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Sparklingstadt ID（OIDC プロバイダー）の issuer。公開 origin（末尾の / は不要）
ID_ISSUER="https://id.sparklingstadt.com"
# ID トークンの署名鍵（ES256 の秘密 JWK）。`pnpm run oidc:keygen` で生成
OIDC_SIGNING_KEY=''
# 鍵をローテーションしたときの古い公開鍵の JSON 配列（任意）。JWKS に残す
OIDC_PREVIOUS_PUBLIC_KEYS=''
# 登録するクライアントの JSON 配列。`pnpm run oidc:client <id>` で作り、redirectUris と postLogoutRedirectUris を足す
OIDC_CLIENTS='[]'
# 確認・再設定メールを送る Resend の API キー
RESEND_API_KEY=""
# メールの差出人（Resend で検証済みのアドレス）
MAIL_FROM="Sparklingstadt ID <id@example.com>"
# E2E 用（任意）：メールを送らずこのファイルに JSON Lines で書く
MAIL_LOG=""
